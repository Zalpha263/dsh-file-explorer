{
  "name": "dsh-file-explorer",
  "version": "2.0.0",
  "description": "Editor add-on for the DSH web client's official read-only file preview: an Edit action in the preview header opens the same file address in an editor tab that writes back with optimistic-concurrency protection. Highlights with the official shared highlighter.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.0-rc.1 <0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.0-rc.1 <0.3.0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "web-ui",
    "editor",
    "plugin"
  ],
  "license": "MIT",
  "files": [
    "lib",
    "locale",
    "test",
    "README.md",
    "LICENSE",
    "cordis.patch.yml"
  ],
  "scripts": {
    "test": "node test/host.test.mjs && node test/client-smoke.test.mjs"
  }
}
